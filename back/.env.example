# Porta do servidor HTTP (o Render injeta a porta do serviço).
PORT=3001
# Interface de escuta.
HOST=0.0.0.0

# Connection string do Postgres do Render.
# Dentro do Render use a URL interna com DATABASE_SSL=false.
# Fora do Render (acesso externo) normalmente é preciso DATABASE_SSL=true.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=false

# Origens permitidas no CORS, separadas por vírgula. Use "*" em desenvolvimento.
CORS_ORIGIN=*

# Duração da sessão em dias.
SESSION_DAYS=30
# Custo do bcrypt (4 a 15).
BCRYPT_ROUNDS=12
# Aplica o schema automaticamente ao iniciar.
AUTO_MIGRATE=true
