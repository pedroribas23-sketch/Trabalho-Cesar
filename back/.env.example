# Connection string do Postgres no Neon (pooled).
# Neon Console -> projeto "kennedito" -> branch "main" -> Connect.
# Use a POOLED (o host tem "-pooler"): e ela que aguenta o trafego da API.
DATABASE_URL=postgresql://USER:SENHA@ep-XXXX-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# O Neon exige SSL na conexao.
DATABASE_SSL=true

# Porta do servidor HTTP (o Render injeta a porta do serviço).
PORT=3001
# Interface de escuta.
HOST=0.0.0.0

# Origens permitidas no CORS, separadas por virgula. Use "*" em desenvolvimento.
CORS_ORIGIN=*

# Tempo de validade da sessao em dias.
SESSION_DAYS=30
# Custo do bcrypt (4 a 15).
BCRYPT_ROUNDS=12
# Aplica o schema automaticamente ao iniciar.
AUTO_MIGRATE=true
